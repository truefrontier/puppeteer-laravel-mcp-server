# Browser settings
BROWSER_POOL_SIZE=5
BROWSER_TIMEOUT=30000
HEADLESS=true
# CHROME_PATH=/path/to/chrome/executable
# Only for a Linux container running as root, where Chrome's sandbox can't start:
# CHROME_NO_SANDBOX=true

# Laravel Herd integration
HERD_DIRECTORY=~/Herd
DEFAULT_DOMAIN_SUFFIX=.test
SSL_ENABLED=true

# MCP server settings
MCP_TRANSPORT=stdio
MCP_PORT=3000
MCP_AUTH_ENABLED=false

# Debug settings
DEBUG_SCREENSHOTS=true
DEBUG_CONSOLE_LOGS=true
VISUAL_DEBUG=true